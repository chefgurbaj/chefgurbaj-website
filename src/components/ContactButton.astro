---
interface Props {
  text?: string;
  intent?: 'consultation' | 'aspiring-chef' | 'general';
  class?: string;
}

const { text = "Contact on WhatsApp", intent = 'general', class: className = '' } = Astro.props;

const phone = '917021293289';

let message = 'Hi Chef Gurbaj, I would like to connect with you.';
if (intent === 'consultation') {
  message = 'Hi Chef Gurbaj, I am interested in booking a consultation for my brand/restaurant.';
} else if (intent === 'aspiring-chef') {
  message = 'Hi Chef Gurbaj, I am an aspiring chef and would like to submit my resume for your review.';
}

const waUrl = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
---

<a 
  href={waUrl}
  target="_blank" 
  rel="noopener noreferrer" 
  class:list={[
    "relative inline-flex items-center justify-center overflow-hidden px-8 py-4 rounded-sm font-heading font-bold uppercase tracking-[0.2em] text-xs md:text-sm transition-all duration-500 group",
    "bg-gradient-to-r from-[#b58b16] via-[#D4AF37] to-[#b58b16] bg-[length:200%_auto] hover:bg-right",
    "text-obsidian-black shadow-[0_10px_30px_-10px_rgba(212,175,55,0.4)] hover:shadow-[0_20px_40px_-15px_rgba(212,175,55,0.7)] hover:-translate-y-1",
    "border border-white/30",
    className
  ]}
>
  <span class="relative z-10">{text}</span>
</a>
