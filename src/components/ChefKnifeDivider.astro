---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class:list={["w-full flex justify-center items-center py-12 relative overflow-hidden", className]}>
  <div class="relative w-64 md:w-96 opacity-60 hover:opacity-100 transition-opacity duration-700">
    <!-- SVG Realistic Chef Knife -->
    <svg viewBox="0 0 400 45" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full drop-shadow-[0_4px_6px_rgba(0,0,0,0.3)] dark:drop-shadow-[0_2px_10px_rgba(212,175,55,0.2)]">
      
      <!-- Handle -->
      <path d="M 10 18 Q 10 14 15 14 L 65 14 L 65 28 L 20 28 Q 10 28 10 23 Z" fill="#1C1C1E" stroke="#000" stroke-width="0.5"/>
      
      <!-- Handle Rivets -->
      <circle cx="25" cy="21" r="2" fill="#888"/>
      <circle cx="40" cy="21" r="2" fill="#888"/>
      <circle cx="55" cy="21" r="2" fill="#888"/>
      
      <!-- Bolster -->
      <path d="M 65 13 L 70 13 L 70 34 C 68 34 65 30 65 28 Z" fill="#A0A0A0"/>

      <!-- Blade (Sleek, elongated) -->
      <path d="M 70 14 L 350 14 Q 380 14 390 22 Q 330 38 150 34 L 70 34 Z" fill="url(#blade-gradient)"/>
      
      <!-- Edge Highlight -->
      <path d="M 70 34 L 150 34 Q 330 38 390 22" stroke="#FFFFFF" stroke-opacity="0.6" stroke-width="0.75"/>
      
      <defs>
        <linearGradient id="blade-gradient" x1="70" y1="14" x2="390" y2="34" gradientUnits="userSpaceOnUse">
          <stop stop-color="#E2E2E2"/>
          <stop offset="0.4" stop-color="#999999"/>
          <stop offset="0.8" stop-color="#555555"/>
          <stop offset="1" stop-color="#D4AF37" stop-opacity="0.3"/> <!-- subtle brass reflection -->
        </linearGradient>
      </defs>
    </svg>
    <!-- Gleam Animation -->
    <div class="absolute inset-0 z-10 w-full h-full pointer-events-none overflow-hidden knife-mask">
       <div class="w-[15%] h-full bg-gradient-to-r from-transparent via-white to-transparent opacity-80 animate-gleam mix-blend-overlay"></div>
    </div>
  </div>
</div>

<style>
  .knife-mask {
    -webkit-mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 400 45' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M 70 14 L 350 14 Q 380 14 390 22 Q 330 38 150 34 L 70 34 Z' fill='black'/%3E%3C/svg%3E");
    mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 400 45' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M 70 14 L 350 14 Q 380 14 390 22 Q 330 38 150 34 L 70 34 Z' fill='black'/%3E%3C/svg%3E");
  }
  .animate-gleam {
    animation: gleam 4s infinite ease-in-out;
  }
  @keyframes gleam {
    0% { transform: translateX(-150%) skewX(-30deg); }
    30% { transform: translateX(600%) skewX(-30deg); }
    100% { transform: translateX(600%) skewX(-30deg); }
  }
</style>
