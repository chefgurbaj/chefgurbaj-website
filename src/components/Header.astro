  <div class="max-w-6xl mx-auto flex flex-col md:flex-row justify-between items-center gap-4">
    <!-- Logo -->
    <a href="/" class="text-2xl font-heading font-semibold tracking-wide text-pristine-white">
      CHEF GURBAJ
