---
import Layout from '../layouts/Layout.astro';
import ContactButton from '../components/ContactButton.astro';
---

<Layout title="Portfolio | Chef Gurbaj">
  <div class="max-w-6xl mx-auto px-4 py-20">
    <div class="text-center mb-16">
      <h1 class="text-4xl md:text-6xl font-heading text-obsidian-black dark:text-pristine-white mb-6">
        Culinary <span class="bg-gradient-to-r from-[#b38b1d] via-[#f8e192] to-[#b38b1d] dark:from-[#d4af37] dark:via-[#f8e192] dark:to-[#d4af37] bg-[length:200%_auto] bg-clip-text text-transparent italic animate-gradient-wave">Portfolio</span>
      </h1>
      <p class="text-xl text-slate-700 dark:text-slate-grey max-w-2xl mx-auto font-light">
        A glimpse into signature creations, elegant plating, and high-volume operations executed with precision.
      </p>
    </div>

    <!-- Placeholder Grid for Portfolio Images -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-20">
      
      <!-- Portfolio Item 1 -->
      <div class="group relative aspect-square bg-slate-grey/10 overflow-hidden border border-slate-300 dark:border-slate-grey/20">
        <div class="absolute inset-0 flex items-center justify-center text-slate-700 dark:text-slate-grey/40 font-heading text-lg group-hover:scale-105 transition-transform duration-700">
          [Image Placeholder]
        </div>
        <div class="absolute inset-0 bg-gradient-to-t from-obsidian-black via-obsidian-black/50 to-transparent opacity-80 md:opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-6">
          <h3 class="text-xl font-heading text-saffron-gold transform translate-y-0 md:translate-y-4 group-hover:translate-y-0 transition-transform duration-300">Signature Entrée</h3>
          <p class="text-sm text-obsidian-black dark:text-pristine-white opacity-100 md:opacity-0 group-hover:opacity-100 transition-opacity duration-300 delay-100">Roxie, Bangalore</p>
        </div>
      </div>

      <!-- Portfolio Item 2 -->
      <div class="group relative aspect-square bg-slate-grey/10 overflow-hidden border border-slate-300 dark:border-slate-grey/20">
        <div class="absolute inset-0 flex items-center justify-center text-slate-700 dark:text-slate-grey/40 font-heading text-lg group-hover:scale-105 transition-transform duration-700">
          [Image Placeholder]
        </div>
        <div class="absolute inset-0 bg-gradient-to-t from-obsidian-black via-obsidian-black/50 to-transparent opacity-80 md:opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-6">
          <h3 class="text-xl font-heading text-saffron-gold transform translate-y-0 md:translate-y-4 group-hover:translate-y-0 transition-transform duration-300">Bespoke Menu Design</h3>
          <p class="text-sm text-obsidian-black dark:text-pristine-white opacity-100 md:opacity-0 group-hover:opacity-100 transition-opacity duration-300 delay-100">OHRI'S GROUP</p>
        </div>
      </div>

      <!-- Portfolio Item 3 -->
      <div class="group relative aspect-square bg-slate-grey/10 overflow-hidden border border-slate-300 dark:border-slate-grey/20">
        <div class="absolute inset-0 flex items-center justify-center text-slate-700 dark:text-slate-grey/40 font-heading text-lg group-hover:scale-105 transition-transform duration-700">
          [Image Placeholder]
        </div>
        <div class="absolute inset-0 bg-gradient-to-t from-obsidian-black via-obsidian-black/50 to-transparent opacity-80 md:opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-6">
          <h3 class="text-xl font-heading text-saffron-gold transform translate-y-0 md:translate-y-4 group-hover:translate-y-0 transition-transform duration-300">High-Volume Plating</h3>
          <p class="text-sm text-obsidian-black dark:text-pristine-white opacity-100 md:opacity-0 group-hover:opacity-100 transition-opacity duration-300 delay-100">RR Hospitality</p>
        </div>
      </div>

    </div>
    
    <div class="bg-slate-grey/5 border border-slate-300 dark:border-slate-grey/20 p-8 md:p-12 text-center max-w-4xl mx-auto">
      <h2 class="text-2xl font-heading text-obsidian-black dark:text-pristine-white mb-4">Want to see more?</h2>
      <p class="text-slate-700 dark:text-slate-grey mb-8">Connect with me on WhatsApp to request a detailed case study or project report.</p>
      <ContactButton intent="general" text="Request Full Portfolio" />
    </div>

  </div>
</Layout>
