---
import Layout from '../layouts/Layout.astro';
import ContactButton from '../components/ContactButton.astro';
---

<Layout title="Portfolio | Chef Gurbaj">
  <div class="max-w-6xl mx-auto px-4 pt-4 pb-20 lg:pt-16">
    <div class="text-center mb-16">
      <h1 class="text-4xl md:text-6xl font-heading mb-6 bg-gradient-to-r from-obsidian-black via-[#997a15] to-obsidian-black dark:from-[#d4af37] dark:via-[#fcf5d2] dark:to-[#d4af37] bg-[length:200%_auto] bg-clip-text text-transparent animate-gradient-wave">
        Culinary <span>Portfolio</span>
      </h1>
      <p class="text-xl text-obsidian-black dark:text-pristine-white max-w-2xl mx-auto font-normal">
        A glimpse into signature creations, elegant plating, and high-volume operations executed with precision.
      </p>
    </div>

    <!-- Portfolio Grid (Flexbox implementation to bypass Safari CSS Column render bugs) -->
    <div class="flex flex-col md:flex-row gap-6 pb-20">
      
      <!-- Column 1 -->
      <div class="flex-1 flex flex-col gap-6">
        <!-- Cabami - 33 -->
        <div class="relative group break-inside-avoid rounded-xl elite-glass p-2 shadow-2xl shadow-obsidian-black/20 dark:shadow-black/80 transition-transform duration-500 hover:-translate-y-2">
          <div class="relative overflow-hidden rounded-lg">
            <img src="/portfolio/CABAMI-33.jpg" alt="CABAMI Concept" class="w-full h-auto object-cover transform group-hover:scale-105 transition-transform duration-1000" loading="eager" />
            <div class="absolute inset-0 bg-gradient-to-t from-obsidian-black/80 via-obsidian-black/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700 z-20 flex flex-col justify-end p-8 pointer-events-none">
              <span class="text-saffron-gold text-sm font-bold tracking-widest uppercase mb-2 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-700">Project</span>
              <h3 class="text-3xl font-heading text-pristine-white m-0 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-700 delay-100">CABAMI</h3>
            </div>
          </div>
        </div>

        <!-- Cabami - 7 -->
        <div class="relative group break-inside-avoid rounded-xl elite-glass p-2 shadow-2xl shadow-obsidian-black/20 dark:shadow-black/80 transition-transform duration-500 hover:-translate-y-2">
          <div class="relative overflow-hidden rounded-lg">
            <img src="/portfolio/CABAMI-7.jpg" alt="CABAMI Interior" class="w-full h-auto object-cover transform group-hover:scale-105 transition-transform duration-1000" loading="eager" />
            <div class="absolute inset-0 bg-gradient-to-t from-obsidian-black/80 via-obsidian-black/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700 z-20 flex flex-col justify-end p-8 pointer-events-none">
              <span class="text-saffron-gold text-sm font-bold tracking-widest uppercase mb-2 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-700">Consultation</span>
              <h3 class="text-3xl font-heading text-pristine-white m-0 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-700 delay-100">CABAMI Architecture</h3>
            </div>
          </div>
        </div>
      </div>

      <!-- Column 2 -->
      <div class="flex-1 flex flex-col gap-6">
        <!-- Fika - 42 -->
        <div class="relative group break-inside-avoid rounded-xl elite-glass p-2 shadow-2xl shadow-obsidian-black/20 dark:shadow-black/80 transition-transform duration-500 hover:-translate-y-2">
          <div class="relative overflow-hidden rounded-lg">
            <img src="/portfolio/Fika42.jpg" alt="Fika Goa" class="w-full h-auto object-cover transform group-hover:scale-105 transition-transform duration-1000" loading="eager" />
            <div class="absolute inset-0 bg-gradient-to-t from-obsidian-black/80 via-obsidian-black/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700 z-20 flex flex-col justify-end p-8 pointer-events-none">
              <span class="text-saffron-gold text-sm font-bold tracking-widest uppercase mb-2 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-700">Project</span>
              <h3 class="text-3xl font-heading text-pristine-white m-0 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-700 delay-100">Fika Goa</h3>
            </div>
          </div>
        </div>

        <!-- Cabami - 12 -->
        <div class="relative group break-inside-avoid rounded-xl elite-glass p-2 shadow-2xl shadow-obsidian-black/20 dark:shadow-black/80 transition-transform duration-500 hover:-translate-y-2">
          <div class="relative overflow-hidden rounded-lg">
            <img src="/portfolio/Cabami12.jpg" alt="CABAMI Details" class="w-full h-auto object-cover transform group-hover:scale-105 transition-transform duration-1000" loading="eager" />
            <div class="absolute inset-0 bg-gradient-to-t from-obsidian-black/80 via-obsidian-black/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700 z-20 flex flex-col justify-end p-8 pointer-events-none">
              <span class="text-saffron-gold text-sm font-bold tracking-widest uppercase mb-2 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-700">Culinary Details</span>
              <h3 class="text-3xl font-heading text-pristine-white m-0 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-700 delay-100">CABAMI Setup</h3>
            </div>
          </div>
        </div>
      </div>

      <!-- Column 3 -->
      <div class="flex-1 flex flex-col gap-6">
        <!-- Cabami - 48 -->
        <div class="relative group break-inside-avoid rounded-xl elite-glass p-2 shadow-2xl shadow-obsidian-black/20 dark:shadow-black/80 transition-transform duration-500 hover:-translate-y-2">
          <div class="relative overflow-hidden rounded-lg">
            <img src="/portfolio/Cabami48.jpg" alt="CABAMI Menu" class="w-full h-auto object-cover transform group-hover:scale-105 transition-transform duration-1000" loading="eager" />
            <div class="absolute inset-0 bg-gradient-to-t from-obsidian-black/80 via-obsidian-black/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700 z-20 flex flex-col justify-end p-8 pointer-events-none">
              <span class="text-saffron-gold text-sm font-bold tracking-widest uppercase mb-2 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-700">Menu Engineering</span>
              <h3 class="text-3xl font-heading text-pristine-white m-0 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-700 delay-100">CABAMI Execution</h3>
            </div>
          </div>
        </div>

        <!-- New Dish -->
        <div class="relative group break-inside-avoid rounded-xl elite-glass p-2 shadow-2xl shadow-obsidian-black/20 dark:shadow-black/80 transition-transform duration-500 hover:-translate-y-2">
          <div class="relative overflow-hidden rounded-lg">
            <img src="/images/plated_gourmet_dish.jpg" alt="Signature Plated Dish" class="w-full h-auto object-cover transform group-hover:scale-105 transition-transform duration-1000" loading="eager" />
            <div class="absolute inset-0 bg-gradient-to-t from-obsidian-black/80 via-obsidian-black/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700 z-20 flex flex-col justify-end p-8 pointer-events-none">
              <span class="text-saffron-gold text-sm font-bold tracking-widest uppercase mb-2 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-700">Signature</span>
              <h3 class="text-3xl font-heading text-pristine-white m-0 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-700 delay-100">Molecular Gastronomy</h3>
            </div>
          </div>
        </div>
      </div>

    </div>
    
    <div class="bg-slate-grey/5 border border-slate-300 dark:border-slate-grey/20 p-8 md:p-12 text-center max-w-4xl mx-auto">
      <h2 class="text-2xl font-heading text-obsidian-black dark:text-pristine-white mb-4">Want to see more?</h2>
      <p class="text-obsidian-black dark:text-pristine-white mb-8">Connect with me on WhatsApp to request a detailed case study or project report.</p>
      <ContactButton intent="general" text="Request Full Portfolio" />
    </div>

  </div>
</Layout>
