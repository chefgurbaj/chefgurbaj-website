---
import Layout from '../layouts/Layout.astro';
import ContactButton from '../components/ContactButton.astro';
---

<Layout title="Portfolio | Chef Gurbaj">
  <div class="max-w-6xl mx-auto px-4 py-20">
    <div class="text-center mb-16">
      <h1 class="text-4xl md:text-6xl font-heading mb-6 bg-gradient-to-r from-[#b38b1d] via-[#f8e192] to-[#b38b1d] dark:from-[#d4af37] dark:via-[#f8e192] dark:to-[#d4af37] bg-[length:200%_auto] bg-clip-text text-transparent animate-gradient-wave">
        Culinary <span class="italic">Portfolio</span>
      </h1>
      <p class="text-xl text-slate-700 dark:text-slate-grey max-w-2xl mx-auto font-light">
        A glimpse into signature creations, elegant plating, and high-volume operations executed with precision.
      </p>
    </div>

    <!-- Placeholder Grid for Portfolio Images -->
    <div class="columns-1 md:columns-2 lg:columns-3 gap-6 space-y-6 pb-20">
      
      <!-- Cabami - 33 -->
      <div class="relative group overflow-hidden break-inside-avoid elite-glass rounded-lg reveal">
        <div class="absolute inset-0 bg-obsidian-black/40 group-hover:bg-transparent transition-colors duration-700 z-10"></div>
        <img src="/portfolio/CABAMI-33.jpg" alt="CABAMI Concept" class="w-full h-auto object-cover transform group-hover:scale-105 transition-transform duration-1000" loading="lazy" />
        <div class="absolute inset-0 bg-gradient-to-t from-obsidian-black via-obsidian-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700 z-20 flex flex-col justify-end p-8">
          <span class="text-saffron-gold text-sm font-bold tracking-widest uppercase mb-2 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-700">Project</span>
          <h3 class="text-3xl font-heading text-pristine-white m-0 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-700 delay-100">CABAMI</h3>
        </div>
      </div>

      <!-- Cabami - 7 -->
      <div class="relative group overflow-hidden break-inside-avoid elite-glass rounded-lg reveal delay-100">
        <div class="absolute inset-0 bg-obsidian-black/40 group-hover:bg-transparent transition-colors duration-700 z-10"></div>
        <img src="/portfolio/CABAMI-7.jpg" alt="CABAMI Interior" class="w-full h-auto object-cover transform group-hover:scale-105 transition-transform duration-1000" loading="lazy" />
        <div class="absolute inset-0 bg-gradient-to-t from-obsidian-black via-obsidian-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700 z-20 flex flex-col justify-end p-8">
          <span class="text-saffron-gold text-sm font-bold tracking-widest uppercase mb-2 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-700">Consultation</span>
          <h3 class="text-3xl font-heading text-pristine-white m-0 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-700 delay-100">CABAMI Architecture</h3>
        </div>
      </div>

      <!-- Fika - 42 -->
      <div class="relative group overflow-hidden break-inside-avoid elite-glass rounded-lg reveal delay-200">
        <div class="absolute inset-0 bg-obsidian-black/40 group-hover:bg-transparent transition-colors duration-700 z-10"></div>
        <img src="/portfolio/Fika42.jpg" alt="Fika Goa" class="w-full h-auto object-cover transform group-hover:scale-105 transition-transform duration-1000" loading="lazy" />
        <div class="absolute inset-0 bg-gradient-to-t from-obsidian-black via-obsidian-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700 z-20 flex flex-col justify-end p-8">
          <span class="text-saffron-gold text-sm font-bold tracking-widest uppercase mb-2 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-700">Project</span>
          <h3 class="text-3xl font-heading text-pristine-white m-0 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-700 delay-100">Fika Goa</h3>
        </div>
      </div>

      <!-- Cabami - 12 -->
      <div class="relative group overflow-hidden break-inside-avoid elite-glass rounded-lg reveal">
        <div class="absolute inset-0 bg-obsidian-black/40 group-hover:bg-transparent transition-colors duration-700 z-10"></div>
        <img src="/portfolio/Cabami12.jpg" alt="CABAMI Details" class="w-full h-auto object-cover transform group-hover:scale-105 transition-transform duration-1000" loading="lazy" />
        <div class="absolute inset-0 bg-gradient-to-t from-obsidian-black via-obsidian-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700 z-20 flex flex-col justify-end p-8">
          <span class="text-saffron-gold text-sm font-bold tracking-widest uppercase mb-2 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-700">Culinary Details</span>
          <h3 class="text-3xl font-heading text-pristine-white m-0 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-700 delay-100">CABAMI Setup</h3>
        </div>
      </div>

      <!-- Cabami - 48 -->
      <div class="relative group overflow-hidden break-inside-avoid elite-glass rounded-lg reveal delay-100">
        <div class="absolute inset-0 bg-obsidian-black/40 group-hover:bg-transparent transition-colors duration-700 z-10"></div>
        <img src="/portfolio/Cabami48.jpg" alt="CABAMI Menu" class="w-full h-auto object-cover transform group-hover:scale-105 transition-transform duration-1000" loading="lazy" />
        <div class="absolute inset-0 bg-gradient-to-t from-obsidian-black via-obsidian-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700 z-20 flex flex-col justify-end p-8">
          <span class="text-saffron-gold text-sm font-bold tracking-widest uppercase mb-2 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-700">Menu Engineering</span>
          <h3 class="text-3xl font-heading text-pristine-white m-0 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-700 delay-100">CABAMI Execution</h3>
        </div>
      </div>

      <!-- New Dish -->
      <div class="relative group overflow-hidden break-inside-avoid elite-glass rounded-lg reveal delay-200">
        <div class="absolute inset-0 bg-obsidian-black/40 group-hover:bg-transparent transition-colors duration-700 z-10"></div>
        <img src="/images/plated_gourmet_dish.jpg" alt="Signature Plated Dish" class="w-full h-auto object-cover transform group-hover:scale-105 transition-transform duration-1000" loading="lazy" />
        <div class="absolute inset-0 bg-gradient-to-t from-obsidian-black via-obsidian-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700 z-20 flex flex-col justify-end p-8">
          <span class="text-saffron-gold text-sm font-bold tracking-widest uppercase mb-2 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-700">Signature</span>
          <h3 class="text-3xl font-heading text-pristine-white m-0 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-700 delay-100">Molecular Gastronomy</h3>
        </div>
      </div>

    </div>
    
    <div class="bg-slate-grey/5 border border-slate-300 dark:border-slate-grey/20 p-8 md:p-12 text-center max-w-4xl mx-auto">
      <h2 class="text-2xl font-heading text-obsidian-black dark:text-pristine-white mb-4">Want to see more?</h2>
      <p class="text-slate-700 dark:text-slate-grey mb-8">Connect with me on WhatsApp to request a detailed case study or project report.</p>
      <ContactButton intent="general" text="Request Full Portfolio" />
    </div>

  </div>
</Layout>
