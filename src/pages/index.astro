---
import Layout from '../layouts/Layout.astro';
import ContactButton from '../components/ContactButton.astro';
import ChefKnifeDivider from '../components/ChefKnifeDivider.astro';
---
<Layout title="Chef Gurbaj | Michelin Noir">
  <section class="relative min-h-[60vh] md:min-h-[85vh] flex flex-col md:flex-row md:items-center justify-center overflow-hidden pt-8 md:pt-0 pb-16 md:pb-0">
    <!-- Cinematic Hero Image -->
    <div class="absolute inset-0 z-0">
      <img src="/images/hero_empty_kitchen_1785773392288.jpg" alt="Empty high-end commercial kitchen" class="w-full h-full object-cover opacity-60 dark:opacity-40 filter blur-[2px] transition-opacity duration-1000" loading="eager" />
    </div>

    <!-- Background Layers -->
    <div class="absolute inset-0 bg-gradient-to-b from-pristine-white/50 to-warm-cream/70 dark:from-obsidian-black/60 dark:to-obsidian-black/80 z-0 pointer-events-none"></div>
    <div class="absolute inset-0 bg-slate-grey/5 dark:bg-slate-grey/10 animate-pulse z-0 pointer-events-none"></div>
    


    <div class="relative z-20 text-center px-4 py-8 md:px-16 md:py-16 max-w-4xl mx-auto flex flex-col items-center animate-fade-in-up drop-shadow-2xl">
      <h1 class="text-5xl md:text-7xl lg:text-8xl font-heading mb-6 tracking-tight bg-gradient-to-r from-obsidian-black via-[#997a15] to-obsidian-black dark:from-[#d4af37] dark:via-[#fcf5d2] dark:to-[#d4af37] bg-[length:200%_auto] bg-clip-text text-transparent animate-gradient-wave">
        Crafting Culinary <br /> <span>Excellence</span>
      </h1>
      
      <p class="text-lg md:text-xl text-obsidian-black dark:text-pristine-white mb-12 max-w-2xl font-body font-medium leading-relaxed">
        High-performing Cluster Executive Chef with a legacy of transforming restaurants, designing elite menus, and leading high-volume culinary operations.
      </p>

      <div class="flex flex-col sm:flex-row gap-6 w-full sm:w-auto justify-center">
        <ContactButton intent="consultation" text="Book a Consultation" />
        <a href="/bio" class="relative inline-flex items-center justify-center overflow-hidden px-8 py-4 rounded-sm font-heading font-bold uppercase tracking-[0.2em] text-xs md:text-sm transition-all duration-500 group border border-obsidian-black/20 dark:border-pristine-white/20 text-obsidian-black dark:text-pristine-white bg-white/10 dark:bg-obsidian-black/20 backdrop-blur-sm shadow-[0_10px_30px_-10px_rgba(10,34,28,0.2)] dark:shadow-[0_10px_30px_-10px_rgba(255,255,255,0.05)] hover:border-saffron-gold hover:text-saffron-gold hover:shadow-[0_20px_40px_-15px_rgba(212,175,55,0.3)] hover:-translate-y-1">
          <span class="relative z-10">View My Journey</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Brands Showcase -->
  <section class="py-16 bg-slate-50 dark:bg-obsidian-black border-y border-slate-grey/10 overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 text-center mb-10">
      <p class="text-sm font-heading text-obsidian-black dark:text-pristine-white uppercase tracking-[0.2em]">Trusted by Industry Leaders</p>
    </div>
    
    <!-- CSS Marquee or Grid for Brands -->
    <div class="relative flex overflow-x-hidden w-full max-w-6xl mx-auto">
      <div class="animate-marquee whitespace-nowrap flex gap-16 items-center transition-all duration-500 py-4">
        <!-- Consultation Brands -->
        <div class="text-xl md:text-2xl font-heading font-semibold text-obsidian-black dark:text-pristine-white">MARA <span class="font-light text-sm tracking-widest text-obsidian-black/70 dark:text-pristine-white/70">Bangalore</span></div>
        <div class="text-xl md:text-2xl font-heading font-serif text-obsidian-black dark:text-pristine-white">Dupion <span class="font-sans text-sm text-obsidian-black/70 dark:text-pristine-white/70">Jaipur</span></div>
        <div class="text-xl md:text-2xl font-heading tracking-widest text-obsidian-black dark:text-pristine-white">CABAMI <span class="font-light tracking-normal text-sm text-obsidian-black/70 dark:text-pristine-white/70">Varanasi</span></div>
        <div class="text-xl md:text-2xl font-body font-light uppercase text-obsidian-black dark:text-pristine-white">FIKA <span class="text-sm text-obsidian-black/70 dark:text-pristine-white/70">Goa</span></div>
        <div class="text-lg md:text-xl font-heading text-obsidian-black dark:text-pristine-white">FIXCABAMI <span class="text-sm font-light text-obsidian-black/70 dark:text-pristine-white/70">Goa</span></div>
        <div class="text-lg md:text-xl font-body font-bold text-obsidian-black dark:text-pristine-white">MINIMALIST HOTEL <span class="font-light text-sm text-obsidian-black/70 dark:text-pristine-white/70">New Delhi</span></div>
        <div class="text-lg md:text-xl font-heading text-obsidian-black dark:text-pristine-white">Hideon Cafe <span class="text-sm font-light text-obsidian-black/70 dark:text-pristine-white/70">Amritsar</span></div>
        
        <!-- Duplicate Set for Marquee Loop -->
        <div class="text-xl md:text-2xl font-heading font-semibold text-obsidian-black dark:text-pristine-white">MARA <span class="font-light text-sm tracking-widest text-obsidian-black/70 dark:text-pristine-white/70">Bangalore</span></div>
        <div class="text-xl md:text-2xl font-heading font-serif text-obsidian-black dark:text-pristine-white">Dupion <span class="font-sans text-sm text-obsidian-black/70 dark:text-pristine-white/70">Jaipur</span></div>
        <div class="text-xl md:text-2xl font-heading tracking-widest text-obsidian-black dark:text-pristine-white">CABAMI <span class="font-light tracking-normal text-sm text-obsidian-black/70 dark:text-pristine-white/70">Varanasi</span></div>
        <div class="text-xl md:text-2xl font-body font-light uppercase text-obsidian-black dark:text-pristine-white">FIKA <span class="text-sm text-obsidian-black/70 dark:text-pristine-white/70">Goa</span></div>
        <div class="text-lg md:text-xl font-heading text-obsidian-black dark:text-pristine-white">FIXCABAMI <span class="text-sm font-light text-obsidian-black/70 dark:text-pristine-white/70">Goa</span></div>
        <div class="text-lg md:text-xl font-body font-bold text-obsidian-black dark:text-pristine-white">MINIMALIST HOTEL <span class="font-light text-sm text-obsidian-black/70 dark:text-pristine-white/70">New Delhi</span></div>
        <div class="text-lg md:text-xl font-heading text-obsidian-black dark:text-pristine-white">Hideon Cafe <span class="text-sm font-light text-obsidian-black/70 dark:text-pristine-white/70">Amritsar</span></div>
        <a href="/portfolio" class="text-obsidian-black dark:text-pristine-white uppercase tracking-widest text-sm hover:text-saffron-gold transition-colors underline underline-offset-8 decoration-saffron-gold/50">
          View My Journey
        </a>
      </div>
    </div>
  </section>

  <!-- Elegant Animated Divider -->
  <section class="bg-pristine-white dark:bg-obsidian-black">
    <ChefKnifeDivider />
  </section>

  <!-- Quick links / features section -->
  <section class="py-16 bg-pristine-white dark:bg-obsidian-black relative overflow-hidden px-4 reveal">
    <!-- Subtle glow behind the cards -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-3/4 h-3/4 bg-saffron-gold/5 blur-[120px] rounded-full pointer-events-none z-0 dark:hidden"></div>
    
    <div class="relative z-10 max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Glass Card 1 -->
      <div class="group elite-glass p-8 hover:-translate-y-2 transition-all duration-700 relative overflow-hidden delay-100">
        <div class="absolute inset-0 bg-gradient-to-br from-white/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        <h3 class="text-2xl font-heading text-[#8a6d1c] dark:text-saffron-gold mb-4 group-hover:scale-105 transition-transform origin-left relative z-10">Brand Incubation</h3>
        <p class="text-obsidian-black dark:text-pristine-white text-sm mb-6 leading-relaxed relative z-10">From concept to kitchen design and menu engineering. Build a restaurant brand that scales.</p>
        <a href="/consultation" class="text-obsidian-black dark:text-pristine-white font-semibold uppercase text-xs tracking-wider hover:text-saffron-gold relative z-10 inline-block border-b border-transparent hover:border-saffron-gold transition-colors pb-1">Learn More &rarr;</a>
      </div>
      
      <!-- Glass Card 2 -->
      <div class="group elite-glass p-8 hover:-translate-y-2 transition-all duration-700 relative overflow-hidden delay-300">
        <div class="absolute inset-0 bg-gradient-to-br from-white/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        <h3 class="text-2xl font-heading text-[#8a6d1c] dark:text-saffron-gold mb-4 group-hover:scale-105 transition-transform origin-left relative z-10">Culinary Portfolio</h3>
        <p class="text-obsidian-black dark:text-pristine-white text-sm mb-6 leading-relaxed relative z-10">Explore a curated gallery of signature dishes, elevated plating, and past high-end projects.</p>
        <a href="/portfolio" class="text-obsidian-black dark:text-pristine-white font-semibold uppercase text-xs tracking-wider hover:text-saffron-gold relative z-10 inline-block border-b border-transparent hover:border-saffron-gold transition-colors pb-1">View Work &rarr;</a>
      </div>
      
      <!-- Glass Card 3 -->
      <div class="group elite-glass p-8 hover:-translate-y-2 transition-all duration-700 relative overflow-hidden delay-500">
        <div class="absolute inset-0 bg-gradient-to-br from-white/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        <h3 class="text-2xl font-heading text-[#8a6d1c] dark:text-saffron-gold mb-4 group-hover:scale-105 transition-transform origin-left relative z-10">Chef Mentorship</h3>
        <p class="text-obsidian-black dark:text-pristine-white text-sm mb-6 leading-relaxed relative z-10">Join my team or seek guidance on accelerating your culinary career and mastering your craft.</p>
        <div class="relative z-10">
          <a href="https://wa.me/917021293289?text=Hi%20Chef%20Gurbaj%2C%20I%20am%20an%20aspiring%20chef%20and%20would%20like%20to%20submit%20my%20resume%20for%20your%20review." target="_blank" rel="noopener noreferrer" class="text-obsidian-black dark:text-pristine-white font-semibold uppercase text-xs tracking-wider hover:text-saffron-gold relative z-10 inline-block border-b border-transparent hover:border-saffron-gold transition-colors pb-1">Connect Now &rarr;</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
