import Layout from '../layouts/Layout.astro';
import ContactButton from '../components/ContactButton.astro';
import ChefKnifeDivider from '../components/ChefKnifeDivider.astro';

<Layout title="Chef Gurbaj | Michelin Noir">
  <section class="relative min-h-[85vh] flex items-center justify-center overflow-hidden">
    <!-- Background Layers -->
    <div class="absolute inset-0 bg-gradient-to-b from-obsidian-black/80 to-obsidian-black z-0 pointer-events-none"></div>
    <div class="absolute inset-0 bg-slate-grey/10 animate-pulse z-0 pointer-events-none"></div>
    
    <!-- Culinary Embers & Steam Effect -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none z-10">
      <!-- Embers -->
      <div class="ember w-2 h-2 bg-saffron-gold rounded-full absolute bottom-0 left-[20%] opacity-0"></div>
      <div class="ember w-3 h-3 bg-orange-400 rounded-full absolute bottom-0 left-[40%] opacity-0 delay-700"></div>
      <div class="ember w-1 h-1 bg-saffron-gold rounded-full absolute bottom-0 left-[60%] opacity-0 delay-300"></div>
      <div class="ember w-4 h-4 bg-[#f8e192] rounded-full absolute bottom-0 left-[80%] opacity-0 delay-1000"></div>
      <div class="ember w-2 h-2 bg-orange-500 rounded-full absolute bottom-0 left-[30%] opacity-0 delay-500"></div>
      <div class="ember w-1 h-1 bg-saffron-gold rounded-full absolute bottom-0 left-[70%] opacity-0 delay-200"></div>
      
      <!-- Rising Steam -->
      <div class="steam steam-1"></div>
      <div class="steam steam-2"></div>
      <div class="steam steam-3"></div>
    </div>

    <div class="relative z-20 text-center px-4 max-w-4xl mx-auto flex flex-col items-center animate-fade-in-up">
      <h1 class="text-5xl md:text-7xl lg:text-8xl font-heading mb-6 tracking-tight text-pristine-white">
        Crafting Culinary <br /> <span class="bg-gradient-to-r from-saffron-gold to-[#f8e192] bg-clip-text text-transparent italic">Excellence</span>
      </h1>
      
      <p class="text-lg md:text-xl text-slate-grey mb-12 max-w-2xl font-body font-light leading-relaxed">
        High-performing Cluster Executive Chef with a legacy of transforming restaurants, designing elite menus, and leading high-volume culinary operations.
      </p>

      <div class="flex flex-col sm:flex-row gap-6 w-full sm:w-auto justify-center">
        <ContactButton intent="consultation" text="Book a Consultation" />
        <a href="/bio" class="inline-block border border-slate-grey text-pristine-white font-semibold px-8 py-4 rounded-sm hover:border-saffron-gold hover:text-saffron-gold transition-colors duration-300">
          View My Journey
        </a>
      </div>
    </div>
  </section>

  <!-- Brands Showcase -->
  <section class="py-16 bg-obsidian-black border-y border-slate-grey/10 overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 text-center mb-10">
      <p class="text-sm font-heading text-slate-grey uppercase tracking-[0.2em]">Trusted by Industry Leaders</p>
    </div>
    
    <!-- CSS Marquee or Grid for Brands -->
    <div class="relative flex overflow-x-hidden w-full max-w-6xl mx-auto">
      <div class="animate-marquee whitespace-nowrap flex gap-16 items-center opacity-60 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-500 py-4">
        <!-- We duplicate the brands twice for seamless looping -->
        <div class="text-xl md:text-2xl font-heading font-semibold text-pristine-white">OHRI'S</div>
        <div class="text-xl md:text-2xl font-heading font-serif italic text-pristine-white">The Oberoi</div>
        <div class="text-xl md:text-2xl font-heading tracking-widest text-pristine-white">ST. REGIS</div>
        <div class="text-xl md:text-2xl font-body font-light uppercase text-pristine-white">Sofitel</div>
        <div class="text-lg md:text-xl font-heading text-pristine-white">RR Hospitality</div>
        <div class="text-lg md:text-xl font-body font-bold text-pristine-white">ROXIE</div>
        <div class="text-lg md:text-xl font-heading italic text-pristine-white">House of Bakers</div>
        <div class="text-lg md:text-xl font-body uppercase tracking-wider text-pristine-white">Sound Cafe</div>
        
        <!-- Duplicate Set -->
        <div class="text-xl md:text-2xl font-heading font-semibold text-pristine-white">OHRI'S</div>
        <a href="/portfolio" class="text-pristine-white uppercase tracking-widest text-sm hover:text-saffron-gold transition-colors underline underline-offset-8 decoration-saffron-gold/50">
          View My Journey
        </a>
      </div>
    </div>
  </section>

  <!-- Elegant Animated Divider -->
  <section class="bg-obsidian-black">
    <ChefKnifeDivider />
  </section>

  <!-- Quick links / features section -->
  <section class="py-16 bg-obsidian-black relative overflow-hidden px-4 reveal">
    <!-- Subtle glow behind the cards -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-3/4 h-3/4 bg-saffron-gold/5 blur-[120px] rounded-full pointer-events-none z-0"></div>
    
    <div class="relative z-10 max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Glass Card 1 -->
      <div class="group elite-glass p-8 hover:-translate-y-2 transition-all duration-700 relative overflow-hidden delay-100">
        <div class="absolute inset-0 bg-gradient-to-br from-white/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        <h3 class="text-2xl font-heading text-saffron-gold mb-4 group-hover:scale-105 transition-transform origin-left relative z-10">Brand Incubation</h3>
        <p class="text-slate-grey text-sm mb-6 leading-relaxed relative z-10">From concept to kitchen design and menu engineering. Build a restaurant brand that scales.</p>
        <a href="/consultation" class="text-pristine-white font-semibold uppercase text-xs tracking-wider hover:text-saffron-gold relative z-10 inline-block border-b border-transparent hover:border-saffron-gold transition-colors pb-1">Learn More &rarr;</a>
      </div>
      
      <!-- Glass Card 2 -->
      <div class="group elite-glass p-8 hover:-translate-y-2 transition-all duration-700 relative overflow-hidden delay-300">
        <div class="absolute inset-0 bg-gradient-to-br from-white/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        <h3 class="text-2xl font-heading text-saffron-gold mb-4 group-hover:scale-105 transition-transform origin-left relative z-10">Culinary Portfolio</h3>
        <p class="text-slate-grey text-sm mb-6 leading-relaxed relative z-10">Explore a curated gallery of signature dishes, elevated plating, and past high-end projects.</p>
        <a href="/portfolio" class="text-pristine-white font-semibold uppercase text-xs tracking-wider hover:text-saffron-gold relative z-10 inline-block border-b border-transparent hover:border-saffron-gold transition-colors pb-1">View Work &rarr;</a>
      </div>
      
      <!-- Glass Card 3 -->
      <div class="group elite-glass p-8 hover:-translate-y-2 transition-all duration-700 relative overflow-hidden delay-500">
        <div class="absolute inset-0 bg-gradient-to-br from-white/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        <h3 class="text-2xl font-heading text-saffron-gold mb-4 group-hover:scale-105 transition-transform origin-left relative z-10">Chef Mentorship</h3>
        <p class="text-slate-grey text-sm mb-6 leading-relaxed relative z-10">Join my team or seek guidance on accelerating your culinary career and mastering your craft.</p>
        <div class="relative z-10">
          <ContactButton intent="aspiring-chef" text="Connect Now" class="!px-0 !py-0 !bg-transparent !text-pristine-white uppercase !text-xs tracking-wider hover:!bg-transparent hover:!text-saffron-gold border-b border-transparent hover:border-saffron-gold rounded-none pb-1" />
        </div>
      </div>
    </div>
  </section>
</Layout>
