---
import Layout from '../layouts/Layout.astro';
import ContactButton from '../components/ContactButton.astro';
---

<Layout title="Consultation | Chef Gurbaj" description="Book a private culinary consultation with Chef Gurbaj. Specializing in Brand Incubation, Menu Engineering, Kitchen Architecture, and Operational Training.">
  <div class="max-w-6xl mx-auto px-4 pt-4 pb-20 lg:pt-16">
    <h1 class="text-4xl md:text-6xl font-heading mb-8 border-b border-slate-300 dark:border-slate-grey/20 pb-6 bg-gradient-to-r from-obsidian-black via-[#997a15] to-obsidian-black dark:from-[#d4af37] dark:via-[#fcf5d2] dark:to-[#d4af37] bg-[length:200%_auto] bg-clip-text text-transparent animate-gradient-wave">
      Culinary <span>Consultation</span>
    </h1>

    <div class="flex flex-col lg:flex-row gap-12">
      <div class="prose dark:prose-invert text-obsidian-black prose-p:text-obsidian-black dark:text-pristine-white dark:prose-p:text-pristine-white/90 prose-headings:text-obsidian-black dark:text-pristine-white max-w-none lg:w-2/3">
        <p class="text-xl font-normal leading-relaxed mb-12">
          Building a successful restaurant goes far beyond a good recipe. It requires meticulous kitchen design, strategic menu engineering, precise food cost management, and a highly trained team. My consultation services are designed to build brands that scale.
        </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
        <button type="button" data-modal-image="/portfolio/menu_engineering.jpg" data-modal-title="Menu Engineering Strategy" class="block w-full text-left bg-slate-50 dark:bg-obsidian-black border border-slate-300 dark:border-slate-grey/20 p-8 hover:border-saffron-gold dark:hover:border-saffron-gold transition-colors group cursor-pointer">
          <h3 class="text-2xl font-heading text-saffron-gold mb-4 group-hover:scale-[1.02] transition-transform origin-left">Menu Engineering</h3>
          <p class="text-sm text-obsidian-black dark:text-pristine-white mb-6">
            Analyzing profitability, developing custom menus that align with your brand, and standardizing production recipes for absolute consistency.
          </p>
          <span class="text-xs uppercase tracking-widest font-semibold text-obsidian-black/50 dark:text-pristine-white/50 group-hover:text-saffron-gold transition-colors">View Setup &rarr;</span>
        </button>
        
        <button type="button" data-modal-image="/portfolio/kitchen_architecture.jpg" data-modal-title="Kitchen Architecture Design" class="block w-full text-left bg-slate-50 dark:bg-obsidian-black border border-slate-300 dark:border-slate-grey/20 p-8 hover:border-saffron-gold dark:hover:border-saffron-gold transition-colors group cursor-pointer">
          <h3 class="text-2xl font-heading text-saffron-gold mb-4 group-hover:scale-[1.02] transition-transform origin-left">Kitchen Architecture</h3>
          <p class="text-sm text-obsidian-black dark:text-pristine-white mb-6">
            Redesigning kitchen stations and equipment placement to dramatically increase workflow productivity and daily output.
          </p>
          <span class="text-xs uppercase tracking-widest font-semibold text-obsidian-black/50 dark:text-pristine-white/50 group-hover:text-saffron-gold transition-colors">View Setup &rarr;</span>
        </button>

        <div class="bg-slate-50 dark:bg-obsidian-black border border-slate-300 dark:border-slate-grey/20 p-8">
          <h3 class="text-2xl font-heading text-saffron-gold mb-4">Cost Control</h3>
          <p class="text-sm text-obsidian-black dark:text-pristine-white">
            Implementing food cost and waste reduction initiatives, auditing vendors, and establishing tight inventory controls.
          </p>
        </div>

        <div class="bg-slate-50 dark:bg-obsidian-black border border-slate-300 dark:border-slate-grey/20 p-8">
          <h3 class="text-2xl font-heading text-saffron-gold mb-4">Staff Training</h3>
          <p class="text-sm text-obsidian-black dark:text-pristine-white">
            Training and mentoring staff in kitchen safety, sanitation, cooking techniques, and seamless dining experience execution.
          </p>
        </div>
      </div>

      <div class="mt-24 mb-16 border-t border-slate-300 dark:border-slate-grey/20 pt-16">
        <h2 class="text-3xl md:text-5xl font-heading mb-6 bg-gradient-to-r from-obsidian-black via-[#997a15] to-obsidian-black dark:from-[#d4af37] dark:via-[#fcf5d2] dark:to-[#d4af37] bg-[length:200%_auto] bg-clip-text text-transparent animate-gradient-wave">
          The <span>Process</span>
        </h2>
        <p class="text-xl font-normal leading-relaxed mb-16">
          Transparency and structure are the foundations of a successful culinary project. This is the exact blueprint we follow to take your restaurant from an initial concept to a highly-profitable, fully operational brand.
        </p>

        <div class="relative border-l border-slate-300 dark:border-slate-grey/30 pl-8 md:pl-12 ml-4 md:ml-0 space-y-16 mb-20">
          
          <!-- Step 1 -->
          <div class="relative">
            <span class="absolute -left-12 md:-left-16 bg-slate-50 dark:bg-obsidian-black text-saffron-gold border border-saffron-gold rounded-full w-8 h-8 flex items-center justify-center font-heading font-bold">1</span>
            <h3 class="text-2xl font-heading text-obsidian-black dark:text-pristine-white mt-0 mb-3">Discovery & Vision Alignment</h3>
            <p class="text-obsidian-black dark:text-pristine-white m-0">
              We begin with a deep dive into your vision, target audience, and business goals. Whether we are auditing an existing operation or building a new brand, we establish clear KPIs and a concrete roadmap.
            </p>
          </div>

          <!-- Step 2 -->
          <div class="relative">
            <span class="absolute -left-12 md:-left-16 bg-slate-50 dark:bg-obsidian-black text-saffron-gold border border-saffron-gold rounded-full w-8 h-8 flex items-center justify-center font-heading font-bold">2</span>
            <h3 class="text-2xl font-heading text-obsidian-black dark:text-pristine-white mt-0 mb-3">Menu Engineering & Kitchen Architecture</h3>
            <p class="text-obsidian-black dark:text-pristine-white m-0">
              Based on the brand identity, we curate the menu, source premium ingredients, and design the kitchen layout to maximize workflow efficiency and minimize prep time.
            </p>
          </div>

          <!-- Step 3 -->
          <div class="relative">
            <span class="absolute -left-12 md:-left-16 bg-slate-50 dark:bg-obsidian-black text-saffron-gold border border-saffron-gold rounded-full w-8 h-8 flex items-center justify-center font-heading font-bold">3</span>
            <h3 class="text-2xl font-heading text-obsidian-black dark:text-pristine-white mt-0 mb-3">Cost Analysis & Vendor Setup</h3>
            <p class="text-obsidian-black dark:text-pristine-white m-0">
              We establish tight food cost controls and leverage my network to secure the best vendor suppliers, ensuring profitability from day one without compromising on quality.
            </p>
          </div>

          <!-- Step 4 -->
          <div class="relative">
            <span class="absolute -left-12 md:-left-16 bg-slate-50 dark:bg-obsidian-black text-saffron-gold border border-saffron-gold rounded-full w-8 h-8 flex items-center justify-center font-heading font-bold">4</span>
            <h3 class="text-2xl font-heading text-obsidian-black dark:text-pristine-white mt-0 mb-3">Staff Training & Mock Service</h3>
            <p class="text-obsidian-black dark:text-pristine-white m-0">
              The backbone of any restaurant is its staff. We conduct rigorous BOH training in sanitation, safety, and plating, followed by dry runs and mock services to ensure flawless execution.
            </p>
          </div>

          <!-- Step 5 -->
          <div class="relative">
            <span class="absolute -left-12 md:-left-16 bg-slate-50 dark:bg-obsidian-black text-saffron-gold border border-saffron-gold rounded-full w-8 h-8 flex items-center justify-center font-heading font-bold">5</span>
            <h3 class="text-2xl font-heading text-obsidian-black dark:text-pristine-white mt-0 mb-3">Launch & Ongoing Audit</h3>
            <p class="text-obsidian-black dark:text-pristine-white m-0">
              We oversee the launch to handle the high-volume pressure. Post-launch, we conduct performance reviews and food spoilage prevention checks to maintain stellar business reputation.
            </p>
          </div>
        </div>
      </div>

      <div class="bg-gradient-to-r from-saffron-gold/10 to-transparent border-l-4 border-saffron-gold p-8 reveal">
        <h2 class="text-2xl font-heading text-obsidian-black dark:text-pristine-white mb-4 mt-0">Ready to build a brand that scales?</h2>
        <p class="text-obsidian-black dark:text-pristine-white mb-8">
          Whether you are launching a new concept or looking to optimize an existing operation, we can architect the perfect solution.
        </p>
        <ContactButton intent="consultation" text="Book a Consultation" />
      </div>
      </div>

      <!-- Cinematic Image Side Panel -->
      <div class="w-full lg:w-1/3 order-first lg:order-last mb-8 lg:mb-0">
        <div class="sticky top-24 reveal delay-100">
          <div class="relative overflow-hidden elite-glass rounded-sm shadow-2xl p-2">
            <img src="/images/luxury_dining_room_1785772100116.jpg" alt="High-end restaurant design" class="w-full h-[400px] lg:h-[600px] object-cover rounded-sm" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-obsidian-black/90 to-transparent"></div>
            <div class="absolute bottom-6 left-6 right-6">
              <p class="text-saffron-gold font-heading text-xl italic m-0">"Design the experience."</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Image Modal -->
  <div id="image-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-obsidian-black/90 backdrop-blur-sm p-4 transition-opacity duration-300 opacity-0">
    <div class="relative max-w-5xl w-full mx-auto flex flex-col items-center transform scale-95 transition-transform duration-300" id="modal-content">
      <button type="button" id="close-modal" class="absolute -top-12 right-0 text-pristine-white hover:text-saffron-gold transition-colors p-2">
        <span class="sr-only">Close</span>
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
      <img id="modal-image" src="" alt="Work Setup" class="w-full h-auto max-h-[80vh] object-contain rounded-sm shadow-2xl" />
      <h3 id="modal-title" class="text-saffron-gold font-heading text-2xl mt-6 tracking-widest uppercase"></h3>
    </div>
  </div>

  <script is:inline>
    const modal = document.getElementById('image-modal');
    const modalContent = document.getElementById('modal-content');
    const modalImage = document.getElementById('modal-image');
    const modalTitle = document.getElementById('modal-title');
    const closeBtn = document.getElementById('close-modal');
    
    // Open Modal
    document.querySelectorAll('button[data-modal-image]').forEach(button => {
      button.addEventListener('click', () => {
        const imgSrc = button.getAttribute('data-modal-image');
        const titleText = button.getAttribute('data-modal-title');
        
        modalImage.src = imgSrc;
        modalTitle.textContent = titleText;
        
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        
        // Trigger animation
        setTimeout(() => {
          modal.classList.remove('opacity-0');
          modalContent.classList.remove('scale-95');
          modalContent.classList.add('scale-100');
        }, 10);
      });
    });
    
    // Close Modal Function
    const closeModal = () => {
      modal.classList.add('opacity-0');
      modalContent.classList.remove('scale-100');
      modalContent.classList.add('scale-95');
      
      setTimeout(() => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        modalImage.src = '';
      }, 300);
    };

    closeBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
    
    // Esc key close
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });
  </script>
</Layout>
